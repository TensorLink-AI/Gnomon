{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gnomon:hosted:evidence-reference:1",
  "title": "Hosted durable evidence reference",
  "description": "Identity only. Resolve through gnomon_hosted with separately authenticated project access.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "service_id",
    "project_id",
    "ledger_id",
    "resource_type",
    "resource_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "service_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "ledger_id": {
      "$ref": "#/$defs/id"
    },
    "resource_type": {
      "enum": [
        "dataset_version",
        "execution",
        "decision",
        "actual",
        "review",
        "lesson",
        "export_receipt",
        "evidence_snapshot",
        "client_analysis"
      ]
    },
    "resource_id": {
      "$ref": "#/$defs/id"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
