# Gnomon configuration — example config showing all options.
#
# Copy to one of these locations and edit:
#   ./gnomon.yaml           (current directory)
#   ~/.config/gnomon/gnomon.yaml
#   $GNOMON_CONFIG_PATH
#
# Or pass explicitly:  gnomon forecast data.csv --config gnomon.yaml ...
#
# Every section is optional. Gnomon works with no config file at all
# (uses sensible defaults: baselines + drift, no TSFMs, no ensemble).
#
# Scope — where this file is honoured:
#   - `gnomon forecast`, `gnomon decide`, `gnomon monitor` (the verbs that
#     run an evaluated forecast), and the Python API's `config=` parameter.
#   - `gnomon investigate` and `gnomon detect` are operator-based and take
#     no model configuration; nothing here changes them.
#   - MCP tool calls never read this file: their behaviour comes entirely
#     from tool parameters and build defaults.
# A key that cannot be honoured fails at load time rather than being
# silently ignored; the same applies to the whole file if PyYAML is absent.

# ---------------------------------------------------------------------------
# Models — which models run as candidates during evaluation
# ---------------------------------------------------------------------------
models:
  # last_value and seasonal_naive always compete and are not configurable:
  # every candidate is selected by beating them, so a pool without them has
  # nothing to select against. Use evaluation.minimum_baseline_improvement
  # to move the bar.
  statistical:
    enabled: true          # false leaves only the baselines, which asks a
                           # real question: does anything beat the naive answer?
    # Which statistical models compete. Omit the key entirely for all of
    # them, which is the default.
    # candidates:
    #   - drift
    #   - linear_trend
    #   - window_average
    #   - theta
    #   - ets
    # (arima is not implemented; naming it is an error, not a silent skip.)

  # Time Series Foundation Models — each runs in an isolated sandbox venv
  # or via API inference (see backends below).
  tsfm:
    # Which TSFMs to try, in order of preference.
    # Only models with a working backend (sandbox venv or API) will actually run.
    candidates:
      - chronos_bolt_mini
      - toto2_22m
      - flowstate
      # - chronos_bolt_small
      # - ttm
      # - moirai2_small
      # - moment_small

    # Per-model overrides
    overrides:
      chronos_bolt_mini:
        backend: sandbox         # sandbox | api | auto (default: auto)
        device: cpu              # cpu | cuda | mps
        timeout: 300              # seconds per inference call
      toto2_22m:
        backend: sandbox
        device: cpu
        timeout: 300
      flowstate:
        backend: sandbox
        device: cpu
        timeout: 300
        # FlowState needs a scale factor per frequency
        scale_factors:
          h: 1.0
          D: 3.43
          W: 0.46
          MS: 2.0

# ---------------------------------------------------------------------------
# Backends — how TSFMs are executed
# ---------------------------------------------------------------------------
backends:
  # Sandbox: isolated venv per TSFM (default for local execution).
  # Each TSFM gets its own Python environment with its own deps.
  sandbox:
    enabled: true
    venv_root: null            # null = ~/.cache/gnomon-tsfm-venvs/ (auto-managed)
    auto_install: true         # auto-create venv on first use if missing

  # API: remote inference via HTTP (for hosted / managed TSFMs).
  # Use this when you don't want to install models locally.
  api:
    enabled: false
    # Global default API settings (per-model overrides in models.tsfm.overrides)
    timeout: 60               # seconds
    retry: 2                  # retry count on transient failures
    # Providers — define named endpoints for different TSFMs
    providers:
      # Example: hosted Chronos via your inference server
      # chronos_bolt_mini:
      #   url: https://inference.example.com/v1/forecast
      #   auth:
      #     type: bearer
      #     token_env: GNOMON_API_KEY      # read token from env var
      #   model: chronos-bolt-mini       # model name on the server
      #   timeout: 30

      # Example: OpenAI-compatible endpoint for TSFMs
      # toto2_22m:
      #   url: https://api.example.com/v1/timeseries
      #   auth:
      #     type: header
      #     header: X-API-Key
      #     token_env: TOTO_API_KEY
      #   model: toto-2.0-22m

      # Example: local Triton / vLLM serving a TSFM
      # flowstate:
      #   url: http://localhost:8000/v2/models/flowstate/infer
      #   auth:
      #     type: none
      #   model: flowstate-r1.1

# ---------------------------------------------------------------------------
# Ensemble — combine multiple model forecasts into one
# ---------------------------------------------------------------------------
ensemble:
  enabled: false
  strategy: weighted_mean      # weighted_mean | median | voting | stacking

  # weighted_mean: weight each model by its inverse backtest error
  weighted_mean:
    min_models: 2              # need at least N successful models to ensemble
    max_weight_ratio: 0.7      # no single model can exceed this weight fraction
    fallback: strongest_baseline  # if too few models succeed, use this

  # median: robust median of all model point forecasts (no weights needed)
  # median:
  #   min_models: 3

  # voting: for direction/threshold decisions, majority vote across models
  # voting:
  #   min_models: 3
  #   threshold: 0.5            # fraction of models needed for consensus

  # stacking: use a meta-model to learn optimal combination (see meta_model)

  # Which models are eligible for ensemble (by name or "all_candidates")
  eligible: all_candidates    # all_candidates | list of model names
  # eligible: [last_value, drift, chronos_bolt_mini, toto2_22m]

  # The ensemble's intervals come from its own fold residuals, not from
  # combining member quantiles, so there is no union/intersection choice to
  # make — combining member intervals would produce a band no fold measured.

# ---------------------------------------------------------------------------
# Meta-model — lightweight learned combination of candidate forecasts
# ---------------------------------------------------------------------------
meta_model:
  enabled: false
  type: linear_regression       # linear_regression | ridge | lasso

  # The meta-model learns: actual ~ w1*model1_forecast + w2*model2_forecast + ...
  # Training data: residuals from all rolling-origin folds across all models.
  # The weights that ship are fit on every fold; the weights that are
  # *scored* are refit leave-one-fold-out, so its selection score is
  # out-of-sample like every member's.

  linear_regression:
    # Regularization to prevent overfitting with few models
    ridge_alpha: 1.0           # L2 regularization strength
    # L1/lasso is not implemented: sparse selection over a handful of models
    # on a handful of folds would drop members on noise.

  # Minimum data requirements
  min_models: 2                # need at least N models with valid fold scores
  min_folds: 3                 # need at least N folds for training
  # Non-negative weights: a model can't have a negative contribution
  non_negative: true           # constrain weights >= 0

  # If the meta-model fails to train, fall back to this strategy
  fallback: weighted_mean      # weighted_mean | median | strongest_baseline

# ---------------------------------------------------------------------------
# LLM reasoning — post-forecast interpretive layer
# ---------------------------------------------------------------------------
llm:
  # LLM reasoning is OPTIONAL and never touches numbers.
  # It can: compare models, explain selection, flag disagreement,
  # suggest alternative models, and draft a narrative summary.

  enabled: false
  mode: interpret              # interpret | compare | challenge

  # interpret: explain the selected forecast, cite evidence, surface caveats
  # compare: contrast models, highlight disagreement, quantify uncertainty spread
  # challenge: play devil's advocate — why might this forecast be wrong?

  # The LLM receives:
  # - The forecast artifact (point, intervals, support, model, scores)
  # - The evidence ledger (fold scores, coverage, warnings)
  # - The model comparison table (which models competed and their scores)
  # - The ensemble/meta-model composition (if used)

  # It may NEVER:
  # - Edit point forecasts or quantiles
  # - Change model selection or support status
  # - Suppress warnings or evidence
  # - Claim causality without evidence

  # Provider (uses Gnomon's LLM adapter protocol — see llm.py)
  adapter: null                # null = use host's adapter (Hermes ctx.llm)
  # adapter:
  #   type: openrouter
  #   api_key_env: OPENROUTER_API_KEY
  #   model: anthropic/claude-sonnet-4

  max_tokens: 2000
  temperature: 0.3             # low temperature for factual interpretation

# ---------------------------------------------------------------------------
# Evaluation — control the backtesting pipeline
# ---------------------------------------------------------------------------
evaluation:
  # Minimum improvement over baseline to select a candidate (2% by default)
  minimum_baseline_improvement: 0.02

  # Rolling-origin fold configuration
  folds:
    # An abstention floor *above* Gnomon's own, which is derived from the
    # horizon and the seasonal period (max(2*season, 2*horizon, 8) of
    # training, plus folds). Omit to use the derived one.
    # min_observations: 144
    #
    # Degraded evaluation is not a switch: Gnomon enters it automatically when
    # fewer than four folds are available and says so in a warning and in
    # the support assessment. Setting it is an error.

  # Only per-series selection is implemented. A global selection would
  # impose one model on series whose backtests disagree.
  selection: per_series

  # Uncertainty calibration
  uncertainty:
    # true (default): pool residuals across the selection folds as well as
    #   the calibration fold. More residuals, but the selected model was
    #   chosen to minimise error on those folds, so they are optimistically
    #   small and the interval is narrower than strict split conformal.
    #   Every run discloses this.
    # false: calibrate on the held-out calibration fold alone. Genuine split
    #   conformal, noisier, wider.
    pool_residuals: true
    #
    # Intervals are NOT scaled by sqrt(step): each lead time's spread is
    # measured at that lead time. Setting temporal_scaling is an error.
    #
    # Nominal coverage of the central interval. 0.80 is what q10/q90 have
    # always meant; changing it changes which residual order statistics are
    # emitted as the bounds.
    target_coverage: 0.80

  # Fixed calibration thresholds (not configurable — listed so their
  # two-tier design is documented somewhere a user reads, not only in
  # source comments):
  #
  #   - Measured coverage below 70% of nominal adds a warning, so the run
  #     is at most weakly_supported. Its intervals still carry probability
  #     weight.
  #   - Measured coverage below 50% additionally fails the verifier's
  #     calibration gate: probability-bearing claims are stripped and the
  #     support assessment says the intervals do not carry probability
  #     weight. A run at 0.6 is warned but verifies; at 0.4 it is warned
  #     AND stripped. The verifier band is wide because the measurement is
  #     one test fold of `horizon` points; it exists to catch calibration
  #     that is plainly broken, not sample noise.
  #
  # Other fixed guardrails a run may cite in its warnings: a candidate on a
  # single selection fold must beat the strongest baseline by 75% to be
  # selected (the short-history guardrail); each lead time needs 8
  # residuals to measure its own interval width, else leads pool; repairs
  # may touch at most 30% of a series' rows (and drop at most 5% under
  # aggressive); anomaly detection needs 16 observations and defaults to a
  # robust z-score threshold of 3.5.

# ---------------------------------------------------------------------------
# Context — how proposed context events may enter a forecast
# ---------------------------------------------------------------------------
context:
  # off (default): every context event must earn its influence through the
  #   fold-ablation gate. Events whose windows lie entirely in the future
  #   have no folds to prove themselves on and are rejected.
  # on: adds a second, typed lane for exactly that class — future-dated
  #   `constraint:*` and `override:*` events admitted by textual
  #   verifiability: a quoted source span, deterministic re-parsing of its
  #   numbers (the proposer never supplies a number that is applied), and
  #   a recent-history consistency check. Constraints clamp the emitted
  #   quantiles onto the stated feasible region; overrides set the stated
  #   window to the stated value with boundary-widened intervals. A
  #   forecast this lane influences reports support `context_trusted`,
  #   carries its history-only counterfactual in evidence, and gains a
  #   `future_context` key in its artifact-ID payload. Events that could
  #   be fold-tested still go through the ablation gate either way.
  future_events: off

# ---------------------------------------------------------------------------
# Output — control artifact generation
# ---------------------------------------------------------------------------
output:
  # artifact.json and lineage.json are always written: the artifact is the
  # run's identity and the lineage is what the verifier checked, so a run
  # without them is not a run.
  write_forecast_csv: true     # forecast.csv — future timestamps + values
  write_summary: true          # summary.md — human-readable result
  write_evidence: true         # evidence.jsonl — evaluation evidence trail
