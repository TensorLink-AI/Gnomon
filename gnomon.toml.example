# Gnomon project configuration (preferred; parsed by Python >=3.11 stdlib)
# Copy to gnomon.toml. Unknown or unsupported keys fail at startup.

[models.statistical]
enabled = true
candidates = ["drift", "linear_trend", "window_average", "theta", "ets", "croston_sba"]

# Optional extra: pip install "gnomon-forecast[statsforecast]". Candidates
# still have to beat the mandatory baselines on Gnomon's rolling folds.
[models.statsforecast]
enabled = false
candidates = ["statsforecast_autoets", "statsforecast_autoarima", "statsforecast_autotheta", "statsforecast_croston_optimized"]

[models.tsfm]
candidates = []

# Single-TSFM project recipe: set models.statistical.enabled = false above
# and replace the empty list with, for example,
# candidates = ["chronos_bolt_mini"]
# This skips every other optional model. Mandatory baselines still compete;
# the setting narrows the contest and does not force the TSFM to publish.

# Strict is the default. Evidence-weighted admission requires a versioned JSON
# registry compiled from independent pinned-revision outcomes. Relative paths
# resolve beside this configuration file.
[models.admission]
policy = "strict" # strict | evidence_weighted
# evidence_registry_path = "model-evidence.json"

# [models.tsfm.overrides.chronos_bolt_mini]
# backend = "sandbox" # auto | sandbox | api | skip

[backends.sandbox]
enabled = true

[backends.api]
enabled = false
timeout = 60
retry = 2

# [backends.api.providers.chronos_bolt_mini]
# url = "https://inference.example.com/v1/forecast"
# model = "chronos-bolt-mini"
# revision = "provider-specific immutable revision"
# timeout = 30
# retry = 2
# [backends.api.providers.chronos_bolt_mini.auth]
# type = "bearer"
# token_env = "GNOMON_API_KEY"
# header = "Authorization"

[ensemble]
enabled = false
strategy = "weighted_mean" # weighted_mean | median | voting

[ensemble.weighted_mean]
min_models = 2
max_weight_ratio = 0.7

# [ensemble.median]
# min_models = 3

# [ensemble.voting]
# min_models = 3
# threshold = 0.5

[meta_model]
enabled = false
min_models = 2
non_negative = true

[meta_model.linear_regression]
ridge_alpha = 0.000001

[evaluation]
minimum_baseline_improvement = 0.02
selection = "per_series"

[evaluation.folds]
# min_observations = 56

[evaluation.uncertainty]
pool_residuals = true
target_coverage = 0.80

[context]
future_events = false
structural_events = false

[output]
write_forecast_csv = true
write_summary = true
write_evidence = true
