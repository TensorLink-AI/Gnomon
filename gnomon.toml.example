# Gnomon operator configuration (TOML, parsed by the Python 3.11+ stdlib).
#
# Copy to providers.toml and pass it explicitly:
#   gnomon capabilities --providers-config providers.toml
#   gnomon mcp serve --providers-config providers.toml
#
# Gnomon never searches the working directory for configuration. Unknown keys
# fail at startup; run `gnomon capabilities --config-schema` for every key.
# Relative paths resolve against this file's directory, not the current
# working directory. Credentials are environment variable *names*, never
# values, and are never agent tool arguments.

schema_version = 1

# Optional SQLite ledger. Forecasts, actuals, scores and decisions are recorded
# here and later revisions never overwrite earlier predictions.
ledger_path = "gnomon-ledger.db"

# Agents may append actuals, record decisions and outcomes only when true.
allow_outcome_writes = false

# Expose gnomon_temporal (date shifts, intervals, event order) to MCP clients.
enable_temporal = false

# Session-only forecast cache for deterministic providers; 0 disables it.
cache_size = 0

# Ephemeris: TensorLink's hosted forecasting models. To enable it, export
# EPHEMERIS_BASE_URL and EPHEMERIS_API_TOKEN, then uncomment this block. An
# uncommented block with the base URL variable unset is a startup error.
# discover = true registers every enabled, healthy hosted model as
# ephemeris/<model> at startup; it needs network access.
#
# [providers.ephemeris]
# kind = "ephemeris"
# base_url_env = "EPHEMERIS_BASE_URL"
# token_env = "EPHEMERIS_API_TOKEN"
# discover = false

# Your own model as a Python callable: module:attribute taking a
# ForecastRequest and returning a ForecastResult. This entry points at the
# example shipped inside the gnomon package, so it loads from a bare install;
# replace it with your own module. Use kind = "factory" when each call needs
# a fresh fitted object.
[providers.my-model]
kind = "callable"
entrypoint = "gnomon.examples.custom_provider:last_value_forecaster"
revision = "my-model/0.0.0"
deterministic = true
